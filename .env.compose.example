# Copy these values into .env in addition to .env.example
# Set POSTGRES_PASSWORD in your shell or .env before `docker compose up`
DATABASE_URL=postgresql+psycopg://review:YOUR_PASSWORD@postgres:5432/review
SCHEMA_AUTO_CREATE=false
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
WORKER_ENABLED=false

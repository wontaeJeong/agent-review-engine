# GHES GitHub App settings. File at GITHUB_PRIVATE_KEY_PATH is mounted via Secret.
GITHUB_API_URL=https://github.internal/api/v3
GITHUB_APP_ID=12345
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=CHANGE_ME
GITHUB_BOT_LOGIN=agent-review-engine[bot]

# SQLite is only for local single-instance tests. PostgreSQL is recommended for deployments.
DATABASE_URL=sqlite:///./review-engine.db
# SCHEMA_AUTO_CREATE=true for development, false when Alembic migrations run separately
SCHEMA_AUTO_CREATE=true

# Jev (metadata only; external model unless deploying your own compatible provider)
JEV_ENABLED=false
JEV_API_URL=http://jev.internal/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.70
JEV_SEND_DESCRIPTION=false

# On-prem OpenAI-compatible model API (vLLM / LiteLLM), base URL normally ends in /v1
LLM_BASE_URL=https://litellm.internal/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=review-model
# Production: restrict all model endpoints to known approved hostnames.
# LLM_ALLOWED_HOSTS=litellm.internal,vllm.internal
# Optional additional model profiles: Repository settings reference these names only.
# Keys must live in server environment / Secret Manager, never inside profile JSON.
# LLM_PROFILES_JSON={"fast":{"base_url":"https://vllm.internal/v1","model":"review-small","api_key_env":"FAST_REVIEW_KEY"}}
LLM_TIMEOUT_SECONDS=120
MAX_DIFF_CHARS=40000
MAX_FILES=120

# EXACT check-run job names; no implicit bypass if missing
LIGHT_CI_CHECKS=light-ci
HEAVY_CI_CHECKS=heavy-ci
# REQUIRED when APPROVAL_MODE=approve: trusted GitHub App ID for CI check runs.
# CI_EXPECTED_APP_ID=123
CHECK_NAME=agent-review-gate

# Start in shadow mode: no PR APPROVE and no pass check
APPROVAL_MODE=report_only
ALLOW_MEDIUM_AUTO_APPROVE=true
AUTO_ENQUEUE=false
# GITHUB_GRAPHQL_URL=https://github.internal/api/graphql
PR_DEBOUNCE_SECONDS=25
CI_WAIT_TIMEOUT_SECONDS=1800
POLL_INTERVAL_SECONDS=5
MAX_ATTEMPTS=6
# ADMIN_METRICS_TOKEN=CHANGE_ME

# Optional: only handle explicitly enrolled repositories (comma-separated)
# REPOSITORY_ALLOWLIST=org/repo1,org/repo2
# BRIDGE_TOKEN=long-random-token-for-merge-group-workflow
WORKER_ENABLED=false
